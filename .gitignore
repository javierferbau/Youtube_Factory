tools/archive/
tools/data/
tools/test_output/
tools/models/

# Backup and temp files
*.bak
*.bak_*
*.backup.*
*.pre_squirrel_fix.json
tools/backup_*
backup_*.json
Notas.txt

# Loose root workflow dumps and temporary metadata
/workflow_*.json
/Gk7AsGpOPt9LeArk*.json
/youtube_metadata.*

