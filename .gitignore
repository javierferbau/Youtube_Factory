# Core dumps and system memory dumps
gpucore.*
core.*
*.core
*.dump

# Python virtual environments & build artifacts
venv
venv/
venv_gpu/
venv_old_cpu/
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
build/
dist/
*.egg-info/

# Databases & SQLite files
*.sqlite
*.sqlite3
*.db
database.sqlite

# Scratch files, test execution dumps and local logs
scratch/
scratch_*
*.log
*.tmp
*.temp
.DS_Store
.agents/
.codegraph/

# Secrets, private tokens, cookies and local history
.env
.env.*
!.env.example
*_AUTO_COOKIES.json
*cookie*.json
*token*.json
*secret*.json
credentials.json
client_secrets.json
answered_comments_history.json
youtube_performance_history.json

