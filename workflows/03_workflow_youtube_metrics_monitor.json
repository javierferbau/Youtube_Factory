        "jsCode": "\nlet results = [];\nlet chKeys = [\n  { key: 'Cocina', id: 'UCIVnLPELybvA8cWWfj3Ap7g' },\n  { key: 'Limpieza', id: 'UCi5-Y8V-Bb3O9N6b9nMjJfQ' },\n  { key: 'Libreria', id: 'UCpegJz54Iaxkla3Ob90E0Dg' },\n  { key: 'Zapateria', id: 'UCUc728vam13Gv5FSHGeCRvw' },\n  { key: 'Barberia', id: 'UCtWrDTdmu44Txjq1-ZTo4VA' },\n  { key: 'Taller', id: 'UCMnjRK7bdopnoh4iKByND1A' }\n];\n\nconst CALIBRATED_FALLBACK = {\n  'Zapateria': {\n    '7d': { search_pct: 42.0, suggested_pct: 38.0, shorts_pct: 20.0, other_pct: 0.0 },\n    '28d': { search_pct: 40.5, suggested_pct: 39.0, shorts_pct: 20.5, other_pct: 0.0 }\n  },\n  'Barberia': {\n    '7d': { search_pct: 35.0, suggested_pct: 45.0, shorts_pct: 20.0, other_pct: 0.0 },\n    '28d': { search_pct: 33.0, suggested_pct: 47.0, shorts_pct: 20.0, other_pct: 0.0 }\n  },\n  'Taller': {\n    '7d': { search_pct: 28.0, suggested_pct: 52.0, shorts_pct: 20.0, other_pct: 0.0 },\n    '28d': { search_pct: 26.5, suggested_pct: 53.5, shorts_pct: 20.0, other_pct: 0.0 }\n  },\n  'Cocina': {\n    '7d': { search_pct: 18.0, suggested_pct: 62.0, shorts_pct: 20.0, other_pct: 0.0 },\n    '28d': { search_pct: 19.0, suggested_pct: 61.0, shorts_pct: 20.0, other_pct: 0.0 }\n  },\n  'Limpieza': {\n    '7d': { search_pct: 22.0, suggested_pct: 58.0, shorts_pct: 20.0, other_pct: 0.0 },\n    '28d': { search_pct: 21.0, suggested_pct: 59.0, shorts_pct: 20.0, other_pct: 0.0 }\n  },\n  'Libreria': {\n    '7d': { search_pct: 25.0, suggested_pct: 55.0, shorts_pct: 20.0, other_pct: 0.0 },\n    '28d': { search_pct: 24.0, suggested_pct: 56.0, shorts_pct: 20.0, other_pct: 0.0 }\n  }\n};\n\nfunction parseTraffic(nodeName) {\n  try {\n    let item = $(nodeName).first().json;\n    if (item && Array.isArray(item.rows) && item.rows.length > 0) {\n      let totalViews = 0;\n      let typeViews = { YT_SEARCH: 0, RELATED_VIDEO: 0, SHORTS: 0, OTHER: 0 };\n      for (let r of item.rows) {\n        let type = r[0];\n        let v = parseInt(r[1] || '0');\n        totalViews += v;\n        if (type === 'YT_SEARCH') typeViews.YT_SEARCH += v;\n        else if (type === 'RELATED_VIDEO') typeViews.RELATED_VIDEO += v;\n        else if (type === 'SHORTS') typeViews.SHORTS += v;\n        else typeViews.OTHER += v;\n      }\n      if (totalViews > 0) {\n        return {\n          live: true,\n          total_views: totalViews,\n          search_pct: Math.round((typeViews.YT_SEARCH / totalViews) * 1000) / 10,\n          suggested_pct: Math.round((typeViews.RELATED_VIDEO / totalViews) * 1000) / 10,\n          shorts_pct: Math.round((typeViews.SHORTS / totalViews) * 1000) / 10,\n          other_pct: Math.round((typeViews.OTHER / totalViews) * 1000) / 10\n        };\n      }\n    }\n  } catch(e) {}\n  return null;\n}\n\nlet allUnansweredComments = [];\n\nfor (let i = 0; i < chKeys.length; i++) {\n    let ch = chKeys[i].key;\n    let chId = chKeys[i].id;\n    let chData = { channel_key: ch, channel_id: chId };\n\n    // Stats\n    try {\n        let nodeName = 'Get Stats ' + ch;\n        let item = $(nodeName).first().json;\n        let c = item.items && item.items[0] ? item.items[0] : null;\n        if (c) {\n            chData.title = c.snippet.title;\n            chData.custom_url = c.snippet.customUrl;\n            chData.views = parseInt(c.statistics.viewCount || '0');\n            chData.subscribers = parseInt(c.statistics.subscriberCount || '0');\n            chData.videos = parseInt(c.statistics.videoCount || '0');\n        } else {\n            chData.views = 0;\n            chData.subscribers = 0;\n            chData.videos = 0;\n        }\n    } catch(e) {\n        chData.error = e.message;\n    }\n\n    // Comments\n    let unanswered = [];\n    try {\n        let commentsNode = 'Get Comments ' + ch;\n        let cItem = $(commentsNode).first().json;\n        if (cItem && Array.isArray(cItem.items)) {\n            for (let t of cItem.items) {\n                let top = t.snippet && t.snippet.topLevelComment ? t.snippet.topLevelComment.snippet : null;\n                if (!top) continue;\n\n                let authorChannelId = top.authorChannelId ? top.authorChannelId.value : null;\n                if (authorChannelId === chId) continue;\n\n                let totalReplies = t.snippet.totalReplyCount || 0;\n                let isAnswered = false;\n\n                if (totalReplies > 0 && t.replies && Array.isArray(t.replies.comments)) {\n                    for (let rep of t.replies.comments) {\n                        let repAuthorId = rep.snippet && rep.snippet.authorChannelId ? rep.snippet.authorChannelId.value : null;\n                        if (repAuthorId === chId) {\n                            isAnswered = true;\n                            break;\n                        }\n                    }\n                }\n\n                if (!isAnswered) {\n                    let commentObj = {\n                        channel_key: ch,\n                        comment_id: t.id,\n                        video_id: top.videoId || null,\n                        author: top.authorDisplayName || 'Desconocido',\n                        text: (top.textDisplay || top.textOriginal || '').replace(/<[^>]+>/g, '').trim(),\n                        published_at: top.publishedAt || null,\n                        total_replies: totalReplies,\n                        url: top.videoId ? 'https://www.youtube.com/watch?v=' + top.videoId + '&lc=' + t.id : 'https://www.youtube.com/channel/' + chId\n                    };\n                    unanswered.push(commentObj);\n                    allUnansweredComments.push(commentObj);\n                }\n            }\n        }\n    } catch(e) {}\n\n    chData.unanswered_comments_count = unanswered.length;\n    chData.unanswered_comments = unanswered;\n\n    // Traffic Sources\n    let t7 = parseTraffic('Get Traffic 7d ' + ch);\n    let t28 = parseTraffic('Get Traffic 28d ' + ch);\n    if (!t7) {\n        let fb7 = CALIBRATED_FALLBACK[ch] ? CALIBRATED_FALLBACK[ch]['7d'] : { search_pct: 25.0, suggested_pct: 55.0, shorts_pct: 20.0, other_pct: 0.0 };\n        t7 = Object.assign({ live: false }, fb7);\n    }\n    if (!t28) {\n        let fb28 = CALIBRATED_FALLBACK[ch] ? CALIBRATED_FALLBACK[ch]['28d'] : { search_pct: 25.0, suggested_pct: 55.0, shorts_pct: 20.0, other_pct: 0.0 };\n        t28 = Object.assign({ live: false }, fb28);\n    }\n    chData.traffic_sources_7d = t7;\n    chData.traffic_sources_28d = t28;\n\n    results.push(chData);\n}\n\nreturn [{\n    json: {\n        channels: results,\n        total_unanswered_comments: allUnansweredComments.length,\n        unanswered_comments: allUnansweredComments\n    }\n}];\n"
